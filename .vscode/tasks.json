{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Iniciar Servidor Backend",
            "type": "shell",
            "command": "node server.js",
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Servidor rodando",
                    "endsPattern": "Servidor rodando"
                }
            }
        }
    ]
}